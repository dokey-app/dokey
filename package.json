{
  "name": "dokey",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Каталог браузерных инструментов для разработчика. Ввод не покидает вкладку.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "astro sync && tsc --noEmit",
    "test:unit": "vitest run",
    "test:e2e": "astro build && playwright test",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test:unit && pnpm test:e2e"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.3",
    "astro": "7.3.1",
    "axe-core": "4.13.0",
    "es-module-lexer": "2.3.2",
    "oxlint": "1.81.0",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "typescript": "7.0.2",
    "vitest": "5.0.0",
    "wrangler": "4.129.0"
  }
}
