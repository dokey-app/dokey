{
  "name": "dokey",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Каталог браузерных инструментов для разработчика. Ввод не покидает вкладку.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node --experimental-strip-types scripts/copy-headers.ts",
    "preview": "astro preview",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "astro sync && tsc --noEmit",
    "test:unit": "vitest run --project unit",
    "test:int": "vitest run --project integration",
    "test:e2e": "playwright test",
    "gate:lh": "node --experimental-strip-types scripts/gates/lighthouse.ts",
    "gate:size": "node --experimental-strip-types scripts/gates/size.ts",
    "gate:persist": "node --experimental-strip-types scripts/gates/persistence.ts",
    "gate:egress": "node --experimental-strip-types scripts/gates/egress.ts",
    "gate:fields": "node --experimental-strip-types scripts/gates/fields.ts",
    "gate:meta": "node --experimental-strip-types scripts/gates/meta.ts",
    "gate:sitemap": "node --experimental-strip-types scripts/gates/sitemap.ts",
    "gate:ladder": "node --experimental-strip-types scripts/gates/ladder.ts",
    "gate:a11y": "node --experimental-strip-types scripts/gates/a11y.ts",
    "gate:provisional": "node --experimental-strip-types scripts/gates/provisional.ts",
    "gate:nomouse": "node --experimental-strip-types scripts/gates/no-mouse.ts",
    "gate:words": "node --experimental-strip-types scripts/gates/marker-words.ts",
    "gate:subset": "node --experimental-strip-types scripts/gates/font-subset.ts",
    "gate:toolids": "node --experimental-strip-types scripts/gates/tool-ids.ts",
    "gate:headers-parity": "node --experimental-strip-types scripts/gates/headers-parity.ts",
    "gates": "node --experimental-strip-types scripts/gates/run-all.ts",
    "check:headers": "node --experimental-strip-types scripts/check-headers.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.63.0",
    "@size-limit/file": "13.0.3",
    "@types/node": "24.13.3",
    "@vitest/browser": "5.0.0",
    "@vitest/browser-playwright": "5.0.0",
    "astro": "7.3.1",
    "axe-core": "4.13.0",
    "oxlint": "1.81.0",
    "playwright": "1.63.0",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "size-limit": "13.0.3",
    "typescript": "7.0.2",
    "vitest": "5.0.0",
    "wrangler": "4.129.0"
  }
}
