# ВЫВОДИТСЯ из infra/headers/policy.ts — единственного источника политики (D-107, ST-03,
# TECH-02). Руками не правится: правка идёт в policy.ts, затем `pnpm build:headers`.
# До T-021 генератора ещё нет, и этот файл написан руками — как и вторая копия в
# infra/docker/nginx.conf; `pnpm gate:headers-parity` сверяет их до тех пор, а после
# T-021 проверяет, что перегенерация не даёт диффа.
# Набор директив — SEC-22; ИНВ-01 держится строкой script-src/connect-src 'self'.

/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; connect-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; require-trusted-types-for 'script'
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Cache-Control: public, max-age=0, must-revalidate

# Ассеты с хешем в имени — длинный TTL и immutable (architecture §5, строка «Ответы хостинга»).
# Правила ниже НЕ отменяют набор из /* : Cloudflare применяет все подходящие правила и
# переопределяет только одноимённые заголовки. В nginx правило обратное — там `add_header`
# на вложенном уровне снимает весь набор уровня выше, поэтому вторая копия политики
# обходится без блоков location и задаёт кеш через map (см. infra/docker/nginx.conf).
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Service worker и robots ревалидируются всегда.
/sw.js
  Cache-Control: no-cache

/robots.txt
  Cache-Control: public, max-age=3600
