# Продукту переменные окружения не нужны: сервера нет, ключей нет, аккаунтов нет
# (ADR-12, ADR-13). Всё ниже — только для конвейера и локальных прогонов.
#
# Настоящий .env в репозиторий не попадает никогда — он в .gitignore, а Claude Code
# запрещено его читать (.claude/settings.json).

# Куда стучится `pnpm check:headers`. По умолчанию — локальный wrangler dev.
DOKEY_TARGET=http://127.0.0.1:8788

# Пропустить G-01 в местном прогоне: Lighthouse поднимает Chrome и стоит минуты.
# В конвейере не выставляется никогда.
DOKEY_SKIP_LH=0

# Только для конвейера, значения живут в секретах GitHub, не здесь:
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
