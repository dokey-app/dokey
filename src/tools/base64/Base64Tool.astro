---
// Разметка Base64 Encoder/Decoder. Пример кодируется на сборке — виден без JS.
import Icon from '../../ui/Icon.astro';
import { EXAMPLE, encodeText } from './logic.ts';

const example = encodeText(EXAMPLE, false);
---

<div class="workbench" data-b64-tool>
  <section class="card">
    <div class="card-head">
      <h2 class="card-title">Ввод</h2>
      <span class="count-badge" data-char-count>0&nbsp;симв.</span>
    </div>
    <div class="card-body">
      <fieldset class="segmented source">
        <legend class="visually-hidden">Что обрабатывать</legend>
        <label><input type="radio" name="b64-source" value="text" checked />Текст</label>
        <label><input type="radio" name="b64-source" value="file" />Файл</label>
      </fieldset>

      <div data-text-pane>
        <label class="visually-hidden" for="b64-input">Текст или base64</label>
        <textarea
          id="b64-input"
          class="input"
          data-input
          spellcheck="false"
          autocomplete="off"
          autocapitalize="off"
          placeholder="Вставьте текст или base64-строку"
          autofocus></textarea>
      </div>

      <div class="file-pane" data-file-pane hidden>
        <input type="file" class="visually-hidden" data-file tabindex="-1" aria-hidden="true" />
        <button type="button" class="btn btn-primary" data-pick>
          <Icon name="upload" /><span class="btn-text">Выбрать файл</span>
        </button>
        <p class="file-info" data-file-info>Файл читается в этой вкладке, внешних запросов — 0</p>
        <div class="progress" data-progress hidden>
          <progress max="100" value="0" data-progress-bar aria-label="Чтение файла"></progress>
          <span data-progress-text></span>
          <button type="button" class="btn btn-small" data-cancel>Отменить</button>
        </div>
      </div>

      <div class="notice notice-error" role="alert" data-error hidden></div>
      <div class="notice notice-warning" data-threshold hidden>
        <span data-threshold-text></span>
        <div>
          <button type="button" class="btn btn-primary" data-process hidden>Обработать</button>
        </div>
      </div>
    </div>
  </section>

  <section class="card">
    <div class="card-head">
      <h2 class="card-title" data-result-label>Пример</h2>
      <div class="actions">
        <button type="button" class="btn btn-small" data-copy>
          <Icon name="copy" /><span class="btn-text">Скопировать</span>
        </button>
        <button type="button" class="btn btn-small btn-ghost" data-clear>
          <Icon name="eraser" /><span class="btn-text">Очистить</span>
        </button>
      </div>
    </div>
    <div class="card-body">
      <div class="toolbar">
        <fieldset class="segmented" data-direction>
          <legend class="visually-hidden">Направление</legend>
          <label><input type="radio" name="b64-direction" value="encode" checked />Кодировать</label
          >
          <label><input type="radio" name="b64-direction" value="decode" />Декодировать</label>
        </fieldset>
        <label class="check"><input type="checkbox" data-url-safe />URL-safe</label>
      </div>
      <pre
        class="code wrap"
        data-output
        tabindex="0"
        role="region"
        aria-label="Результат">{example}</pre>
      <div class="binary" data-binary hidden>
        <p class="badge binary-info" data-binary-info></p>
        <pre
          class="code"
          data-hex
          tabindex="0"
          role="region"
          aria-label="Первые байты в шестнадцатеричном виде">
        </pre>
        <button type="button" class="btn btn-primary" data-download>
          <Icon name="download" /><span class="btn-text">Скачать файл</span>
        </button>
      </div>
    </div>
  </section>
</div>

<script>
  import './ui.ts';
</script>

<style>
  .source {
    margin-bottom: var(--space-3);
  }

  .file-pane {
    padding: var(--space-6);
    border: 1px dashed var(--border-control);
    border-radius: var(--radius-md);
  }

  .file-info {
    margin: var(--space-3) 0 0;
    font: var(--type-ui);
    color: var(--text-muted);
    overflow-wrap: anywhere;
  }

  .progress {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-3);
    font: var(--type-ui);
  }

  .wrap {
    max-height: 640px;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .binary-info {
    margin: 0 0 var(--space-2);
  }

  .binary .btn {
    margin-top: var(--space-3);
  }
</style>
