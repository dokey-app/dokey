---
// Разметка JWT Inspector. Пример разбирается на сборке — виден без JS;
// относительное время («4 часа назад») и местное время досчитывает ui.ts.
import Icon from '../../ui/Icon.astro';
import { EXAMPLE, claimLabel, decodeJwt, formatInstant } from './logic.ts';

const example = decodeJwt(EXAMPLE);
if (!example.ok) throw new Error('EXAMPLE в src/tools/jwt/logic.ts не разбирается');
const jwt = example.value;
const now = Math.floor(Date.now() / 1000);
---

<div class="workbench" data-jwt-tool>
  <section class="card">
    <div class="card-head">
      <label class="card-title" for="jwt-input">Токен</label>
      <span class="count-badge" data-char-count>0&nbsp;симв.</span>
    </div>
    <div class="card-body">
      <textarea
        id="jwt-input"
        class="input"
        data-input
        spellcheck="false"
        autocomplete="off"
        autocapitalize="off"
        placeholder="Вставьте токен"
        autofocus></textarea>
      <div class="notice notice-error" role="alert" data-error hidden></div>
      <div class="clear-row">
        <button type="button" class="btn btn-small btn-ghost" data-clear>
          <Icon name="eraser" /><span class="btn-text">Очистить</span>
        </button>
      </div>
    </div>
  </section>

  <div>
    <section class="card">
      <div class="card-head">
        <h2 class="card-title" data-result-label>Пример</h2>
        <p class="badge verdict" data-verdict>Подпись не проверялась</p>
      </div>
      <div class="card-body">
        <div class="part-head">
          <h3 class="part-title">header</h3>
          <button
            type="button"
            class="btn btn-small"
            data-copy="header"
            aria-label="Скопировать header"
          >
            <Icon name="copy" /><span class="btn-text">Скопировать</span>
          </button>
        </div>
        <pre class="code" data-header tabindex="0">{jwt.header}</pre>

        <div class="part-head">
          <h3 class="part-title">payload</h3>
          <button
            type="button"
            class="btn btn-small"
            data-copy="payload"
            aria-label="Скопировать payload"
          >
            <Icon name="copy" /><span class="btn-text">Скопировать</span>
          </button>
        </div>
        <pre class="code" data-payload tabindex="0">{jwt.payload}</pre>

        <section data-claims-section hidden={jwt.claims.length === 0}>
          <h3 class="part-title">Время</h3>
          <dl class="claims" data-claims>
            {
              jwt.claims.map((claim) => (
                <div>
                  <dt>{claim.name}</dt>
                  <dd>
                    <span class="claim-label">{claimLabel(claim, now)}</span>
                    <span class="claim-raw">{`${claim.seconds} · ${formatInstant(claim.seconds, 'UTC')}`}</span>
                  </dd>
                </div>
              ))
            }
          </dl>
        </section>

        <h3 class="part-title">signature</h3>
        <pre class="code signature" data-signature tabindex="0">{jwt.signature}</pre>
      </div>
    </section>

    <section class="card">
      <details class="verify" data-verify>
        <summary class="card-head">
          <span class="card-title">Проверить подпись</span>
          <span class="count-badge" data-alg>{jwt.alg}</span>
        </summary>
        <div class="card-body">
          <p class="hint" data-verify-hint>Ключ нужен только для проверки подписи</p>
          <label class="field-label" for="jwt-key">Ключ подписи</label>
          <div class="key-row">
            <input
              id="jwt-key"
              class="key masked"
              type="text"
              data-key
              autocomplete="off"
              spellcheck="false"
              autocapitalize="off"
            />
            <button type="button" class="btn" data-toggle-key aria-pressed="false">Показать</button>
          </div>
          <button type="button" class="btn btn-primary" data-verify-button disabled>
            <Icon name="shield-check" /><span class="btn-text">Проверить подпись</span>
          </button>
        </div>
      </details>
    </section>
  </div>
</div>

<script>
  import './ui.ts';
</script>

<style>
  .clear-row {
    margin-top: var(--space-3);
  }

  .part-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin: var(--space-4) 0 var(--space-2);
  }

  .part-head:first-child {
    margin-top: 0;
  }

  .part-title {
    margin: var(--space-4) 0 var(--space-2);
    font: var(--type-ui);
    font-weight: 600;
    color: var(--text-strong);
  }

  .part-head .part-title {
    margin: 0;
  }

  .signature {
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .verdict {
    margin: 0;
    white-space: normal;
  }

  /* Строки claims пересоздаёт ui.ts — scoped-стили до них не дотягиваются. */
  .claims {
    margin: 0;
  }

  .claims :global(div) {
    display: grid;
    grid-template-columns: 3em minmax(0, 1fr);
    gap: var(--space-2);
    padding: var(--space-2) 0;
    border-bottom: 1px solid var(--border-subtle);
  }

  .claims :global(dt) {
    font-family: var(--font-mono);
    color: var(--text-strong);
  }

  .claims :global(dd) {
    margin: 0;
  }

  .claims :global(.claim-label),
  .claims :global(.claim-raw) {
    display: block;
  }

  .claims :global(.claim-raw) {
    font: var(--type-ui);
    color: var(--text-muted);
  }

  .verify summary {
    cursor: pointer;
    list-style: none;
  }

  .verify:not([open]) summary {
    border-bottom: 0;
  }

  .verify summary::before {
    content: '▸';
    margin-right: var(--space-2);
    color: var(--text-muted);
  }

  .verify[open] summary::before {
    content: '▾';
  }

  .verify summary .card-title {
    flex: 1;
  }

  .hint {
    margin: 0 0 var(--space-3);
    font: var(--type-ui);
    color: var(--text-muted);
  }

  .key-row {
    display: flex;
    gap: var(--space-2);
    margin-bottom: var(--space-3);
  }

  .key {
    flex: 1;
    min-width: 0;
    min-height: var(--control-height-md);
    padding: 0 var(--space-3);
    font: var(--type-code);
    color: var(--text-strong);
    background: var(--surface-card);
    border: 1px solid var(--border-control);
    border-radius: var(--radius-md);
  }

  /* Маска без type="password": менеджер паролей не предлагает сохранить ключ подписи. */
  .masked {
    -webkit-text-security: disc;
    text-security: disc;
  }
</style>
