---
import Base from '../layouts/Base.astro';
import { tools } from '../registry/tools.ts';
---

<Base title="DoKey — утилиты разработчика в браузере" description="Утилиты разработчика в браузере">
  <h1>DoKey</h1>
  <p>Утилиты разработчика в браузере</p>
  {
    tools.length > 0 && (
      <ul>
        {tools.map((tool) => (
          <li>
            <a href={`/${tool.id}`}>{tool.name}</a>
          </li>
        ))}
      </ul>
    )
  }
</Base>
