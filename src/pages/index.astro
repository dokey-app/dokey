---
import Detector from '../detect/Detector.astro';
import Base from '../layouts/Base.astro';
import { tools } from '../registry/tools.ts';
import Icon from '../ui/Icon.astro';
---

<Base
  title="DoKey — утилиты разработчика в браузере"
  description="JSON, JWT, Base64, URL, Unix timestamp, UUID и ULID в одной вкладке. Вставленное распознаётся само, ввод не покидает браузер."
>
  <h1>Утилиты разработчика</h1>
  <p class="lead">Всё считается в этой вкладке — ввод не покидает браузер.</p>

  <Detector />

  <section class="catalog" aria-labelledby="catalog-title">
    <h2 id="catalog-title">Инструменты</h2>
    <ul>
      {
        tools.map((tool) => (
          <li>
            <a class="tool-card" href={`/${tool.id}`}>
              <span class="tool-icon">
                <Icon name={tool.icon} size={22} />
              </span>
              <span class="tool-name">{tool.name}</span>
              <span class="tool-desc">{tool.title}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Base>

<style>
  .lead {
    color: var(--text-muted);
  }

  .catalog {
    margin-top: var(--space-12);
  }

  .catalog ul {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(238px, 1fr));
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* ToolCard дизайн-системы: плитка-ссылка, иконка в мягкой акцентной плашке. */
  .tool-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    height: 100%;
    padding: var(--space-4);
    color: inherit;
    text-decoration: none;
    background: var(--surface-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-xs);
    transition:
      transform var(--duration-fast) var(--ease-standard),
      box-shadow var(--duration-fast) var(--ease-standard),
      border-color var(--duration-fast) var(--ease-standard);
  }

  .tool-card:hover {
    transform: translateY(-1px);
    border-color: var(--border-accent);
    box-shadow: var(--shadow-md);
  }

  .tool-card:focus-visible {
    border-radius: var(--radius-xl);
  }

  .tool-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    margin-bottom: var(--space-2);
    color: var(--text-link);
    background: var(--surface-accent-soft);
    border-radius: var(--radius-md);
  }

  .tool-icon :global(.icon) {
    width: 22px;
    height: 22px;
    vertical-align: 0;
  }

  .tool-name {
    font-weight: 700;
    color: var(--text-strong);
  }

  .tool-desc {
    font: var(--type-ui);
    color: var(--text-muted);
  }
</style>
