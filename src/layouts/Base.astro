---
// Единственный макет: шапка со счётчиком внешних запросов, статус-регионы, подвал.
// noindex держится до релиза v1.0.0 (ROADMAP, срез 10).
import '../styles/tokens.css';
import '../styles/base.css';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <title>{title}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <header class="topbar">
      <a class="brand" href="/">DoKey</a>
      <p class="egress">Внешних запросов: <span data-egress-count>0</span></p>
    </header>
    <main id="main" class="page">
      <slot />
    </main>
    <footer class="footer">
      <a href="https://github.com/dokey-app/dokey">Исходный код на GitHub</a>
    </footer>
    <div class="visually-hidden" role="status" aria-live="polite" data-status></div>
    <div class="visually-hidden" role="alert" data-alert></div>
    <script>
      import '../egress/counter.ts';
    </script>
  </body>
</html>

<style>
  .topbar {
    position: sticky;
    top: 0;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    min-height: var(--topbar-height);
    padding: 0 var(--page-gutter);
    background: var(--surface-card);
    border-bottom: 1px solid var(--border-subtle);
  }

  .brand {
    font: var(--type-ui);
    font-size: var(--text-lg);
    font-weight: 700;
    color: var(--text-strong);
    text-decoration: none;
  }

  .egress {
    margin: 0;
    font: var(--type-ui);
    color: var(--text-muted);
  }

  .egress span {
    font-family: var(--font-mono);
    color: var(--text-strong);
  }

  .page {
    max-width: var(--page-max);
    margin: 0 auto;
    padding: var(--space-8) var(--page-gutter) var(--space-12);
  }

  .footer {
    max-width: var(--page-max);
    margin: 0 auto;
    padding: var(--space-6) var(--page-gutter);
    border-top: 1px solid var(--border-subtle);
    font: var(--type-ui);
  }

  @media (max-width: 640px) {
    .topbar,
    .page,
    .footer {
      padding-inline: var(--space-4);
    }
  }
</style>
