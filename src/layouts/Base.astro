---
// Единственный макет: левое меню, шапка (крошки и счётчик внешних запросов), статус-регионы.
// noindex держится до релиза v1.0.0 (ROADMAP, срез 10).
import '@fontsource-variable/manrope';
import '@fontsource-variable/jetbrains-mono';
import '../styles/tokens.css';
import '../styles/base.css';
import Icon from '../ui/Icon.astro';
import Sidebar from '../ui/Sidebar.astro';
import Wordmark from '../ui/Wordmark.astro';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <title>{title}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <Sidebar />
    <div class="content">
      <header class="topbar">
        <button class="btn btn-ghost icon-btn menu" type="button" popovertarget="sidebar">
          <Icon name="menu" /><span class="visually-hidden">Меню</span>
        </button>
        <Wordmark class="topbar-brand" />
        <slot name="crumbs" />
        <p class="egress">
          <Icon name="shield-check" />
          Внешних запросов: <span data-egress-count>0</span> ·
          <a href="/how-to-verify">Как это проверить</a>
        </p>
      </header>
      <main id="main" class="page">
        <slot />
      </main>
    </div>
    <div class="visually-hidden" role="status" aria-live="polite" data-status></div>
    <div class="visually-hidden" role="alert" data-alert></div>
    <script>
      import '../egress/counter.ts';
    </script>
  </body>
</html>

<style>
  body {
    display: grid;
    grid-template-columns: var(--sidebar-width) minmax(0, 1fr);
    min-height: 100dvh;
  }

  .content {
    min-width: 0;
  }

  .topbar {
    position: sticky;
    top: 0;
    z-index: 1;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-4);
    min-height: var(--topbar-height);
    padding: 0 var(--page-gutter);
    /* Единственное место системы с размытием: полупрозрачная шапка поверх контента. */
    background: color-mix(in srgb, var(--surface-card) 88%, transparent);
    backdrop-filter: saturate(180%) blur(8px);
    border-bottom: 1px solid var(--border-subtle);
  }

  .menu,
  .topbar :global(.topbar-brand) {
    display: none;
  }

  .egress {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 6px;
    margin: 0 0 0 auto;
    font: var(--type-ui);
    color: var(--text-muted);
  }

  .egress :global(.icon) {
    color: var(--text-success);
  }

  .egress span {
    font-family: var(--font-mono);
    color: var(--text-strong);
  }

  .page {
    max-width: var(--page-max);
    margin: 0 auto;
    padding: var(--space-8) var(--page-gutter) var(--space-16);
  }

  @media (max-width: 899px) {
    body {
      display: block;
    }

    .menu {
      display: inline-flex;
    }

    .topbar :global(.topbar-brand) {
      display: inline;
    }

    .topbar {
      gap: var(--space-1) var(--space-2);
    }

    .topbar :global(.crumbs) {
      display: none;
    }

    .topbar,
    .page {
      padding-inline: var(--space-4);
    }
  }
</style>
