---
// Единственный макет: шапка со счётчиком внешних запросов, статус-регионы, подвал.
import '@fontsource-variable/manrope';
import '@fontsource-variable/jetbrains-mono';
import '../styles/tokens.css';
import '../styles/base.css';
import Icon from '../ui/Icon.astro';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <title>{title}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <header class="topbar">
      <a class="brand" href="/"
        ><span class="brand-do">Do</span><span class="brand-key">Key</span></a
      >
      <p class="egress">
        <Icon name="shield-check" />
        Внешних запросов: <span data-egress-count>0</span> ·
        <a href="/how-to-verify">Как это проверить</a>
      </p>
    </header>
    <main id="main" class="page">
      <slot />
    </main>
    <footer class="footer">
      <a href="https://github.com/dokey-app/dokey">Исходный код на GitHub</a>
    </footer>
    <div class="visually-hidden" role="status" aria-live="polite" data-status></div>
    <div class="visually-hidden" role="alert" data-alert></div>
    <script>
      import '../egress/counter.ts';
    </script>
  </body>
</html>

<style>
  .topbar {
    position: sticky;
    top: 0;
    z-index: 1;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-1) var(--space-4);
    min-height: var(--topbar-height);
    padding: 0 var(--page-gutter);
    /* Единственное место системы с размытием: полупрозрачная шапка поверх контента. */
    background: color-mix(in srgb, var(--surface-card) 88%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--border-subtle);
  }

  /* Вордмарк набором: Manrope 800, трекинг −0.03em, вторая часть — акцентом. */
  .brand {
    font: 800 20px / 1 var(--font-sans);
    letter-spacing: -0.03em;
    text-decoration: none;
  }

  .brand-do {
    color: var(--text-strong);
  }

  .brand-key {
    color: var(--text-link);
  }

  .egress {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 6px;
    margin: 0;
    font: var(--type-ui);
    color: var(--text-muted);
  }

  .egress :global(.icon) {
    color: var(--text-success);
  }

  .egress span {
    font-family: var(--font-mono);
    color: var(--text-strong);
  }

  .page {
    max-width: var(--page-max);
    margin: 0 auto;
    padding: var(--space-8) var(--page-gutter) var(--space-12);
  }

  .footer {
    max-width: var(--page-max);
    margin: 0 auto;
    padding: var(--space-6) var(--page-gutter);
    border-top: 1px solid var(--border-subtle);
    font: var(--type-ui);
  }

  @media (max-width: 640px) {
    .topbar,
    .page,
    .footer {
      padding-inline: var(--space-4);
    }
  }
</style>
