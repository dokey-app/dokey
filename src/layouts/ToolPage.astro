---
// Страница инструмента = лендинг: H1 — продуктовое имя (до трёх слов, дизайн-система),
// поисковая формулировка — в <title> и в первой фразе описания. FAQ виден без JS.
import { getCategory, type Tool } from '../registry/tools.ts';
import Base from './Base.astro';

interface Props {
  tool: Tool;
}

const { tool } = Astro.props;
---

<Base title={`${tool.title} — DoKey`} description={tool.description}>
  <nav class="crumbs" aria-label="Путь" slot="crumbs">
    <a href="/">Инструменты</a>
    <span aria-hidden="true">/</span>
    <span>{getCategory(tool.category)}</span>
    <span aria-hidden="true">/</span>
    <span aria-current="page">{tool.name}</span>
  </nav>
  <h1>{tool.name}</h1>
  <p class="intro">{tool.description}</p>
  <slot />
  <section class="faq" aria-labelledby="faq-title">
    <h2 id="faq-title">Вопросы</h2>
    <dl>
      {
        tool.faq.map((item) => (
          <>
            <dt>{item.q}</dt>
            <dd>{item.a}</dd>
          </>
        ))
      }
    </dl>
  </section>
</Base>

<style>
  .crumbs {
    display: flex;
    gap: var(--space-2);
    font: var(--type-ui);
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  .crumbs a {
    color: var(--text-muted);
  }

  .crumbs a:hover {
    color: var(--text-strong);
  }

  .crumbs [aria-current] {
    color: var(--text-strong);
  }

  .intro {
    max-width: 68ch;
    font-size: var(--text-base);
    color: var(--text-muted);
  }

  .faq {
    max-width: 68ch;
    margin-top: var(--space-12);
  }

  dt {
    margin-top: var(--space-4);
    font-weight: var(--weight-semibold);
    color: var(--text-strong);
  }

  dd {
    margin: var(--space-1) 0 0;
  }
</style>
